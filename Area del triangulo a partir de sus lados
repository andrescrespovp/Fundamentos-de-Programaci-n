#include <iostream>
#include <math.h>
using namespace std;
int main()
{
    float area, s, lado1, lado2, lado3;
    cout<<"Escribe el lado 1: "<<endl;
    cin>>lado1;
    cout<<"Escribe el lado 2: "<<endl;
    cin>>lado2;
    cout<<"Escribe el lado 3: "<<endl;
    cin>>lado3;
    s=(lado1 + lado2 + lado3)/2;
    area = sqrt(s*(s - lado1)*(s - lado2)*(s - lado3));
    cout<<"El área a partir de los lados del triángulo es:"<< area;
    return 0;
}
