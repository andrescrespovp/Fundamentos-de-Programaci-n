# REGISTRAR PERSONA
def registrar_persona():
    print("\n--- REGISTRAR PERSONA ---")

    nombre = input("Nombre: ")
    fecha = input("Fecha de nacimiento (DD/MM/AAAA): ")

    while not validar_fecha(fecha):
        print("Fecha incorrecta. Ingrese una fecha real.")
        fecha = input("Fecha de nacimiento (DD/MM/AAAA): ")

    ci = input("CI: ")
    direccion = input("Direccion: ")
    telefono = input("Telefono: ")
    web = input("Web: ")
    
    persona = [nombre, fecha, ci, direccion, telefono, web]
    personas.append(persona)

    print("Persona registrada correctamente.")


# LISTAR PERSONAS
def listar_personas():
    print("\n--- LISTA DE PERSONAS ---")

    if len(personas) == 0:
        print("No existen personas registradas.")
    else:
        for i in range(len(personas)):
            print("\nPersona Nro:", i + 1)
            print("Nombre:", personas[i][0])
            print("Fecha de nacimiento:", personas[i][1])
            print("CI:", personas[i][2])
            print("Direccion:", personas[i][3])
            print("Telefono:", personas[i][4])
            print("Web :", personas[i][5])

# BORRAR PERSONA
