# VECTORES
usuarios = []
personas = []


# VALIDAR FECHA DE NACIMIENTO
def validar_fecha(fecha):
    if len(fecha) != 10 or fecha[2] != "/" or fecha[5] != "/":
        return False

    if not (fecha[0:2] + fecha[3:5] + fecha[6:10]).isdigit():
        return False

    dia = int(fecha[0:2])
    mes = int(fecha[3:5])
    anio = int(fecha[6:10])

    if anio < 1:
        return False

    if mes < 1 or mes > 12:
        return False

    # Verificar cantidad de dias del mes
    if mes == 2:
        # Verificar año bisiesto
        if anio % 400 == 0 or (anio % 4 == 0 and anio % 100 != 0):
            dias = 29
        else:
            dias = 28

    elif mes == 4 or mes == 6 or mes == 9 or mes == 11:
        dias = 30

    else:
        dias = 31

    if dia < 1 or dia > dias:
        return False

    return True


# REGISTRAR USUARIO
def registrar_usuario():
    print("\n--- REGISTRAR USUARIO ---")
    usuario = input("Ingrese usuario: ")

    # Verificar si el usuario ya existe
    for u in usuarios:
        if u[0] == usuario:
            print("El usuario ya existe.")
            return

    clave = input("Ingrese contraseña: ")
    usuarios.append([usuario, clave])
    print("Usuario registrado correctamente.")


# LISTAR USUARIOS
def listar_usuarios():
