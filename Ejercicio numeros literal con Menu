#include <iostream>
#include <string>

using namespace std;
string posicion(int n, string num[]);
void cargar(string num[], int &cantidad);
void mostrar(string num[], int cantidad);
string ejecutar(string num[], int numero);

int main() {
    int n, opcion, numero, cantidad = 0;
    string num[20];
    string resultado;
    do {
        cout << "\n===============================\n";
        cout << "        MENU PRINCIPAL         \n";
        cout << "===============================\n";
        cout << "1. Cargar arreglo\n";
        cout << "2. Mostrar arreglo\n";
        cout << "3. Ejecutar busqueda por posicion\n";
        cout << "0. Salir\n";
        cout << "Ingrese una opcion: ";
        cin >> opcion;

        switch (opcion) {
        case 1:
            cargar(num, cantidad);
            break;
        case 2:
            mostrar(num, cantidad);
            break;
        case 3:
            cout << "Ingrese un numero (maximo 20): ";
            cin >> numero;
            cout<< ejecutar(num, numero);
            break;
        case 0:
            cout << "Saliendo del programa...\n";
            break;
        default:
            cout << "Opcion invalida. Intente de nuevo.\n";
        }
    } while (opcion != 0);
    return 0;
}
void cargar(string num[], int &cantidad){
    cout << "Cantidad de elementos que desea ingresar (maximo 20): ";
    cin >> cantidad;
    if (cantidad >= 1 && cantidad < 20)
        for (int i = 0; i < cantidad; i++) {
            cout << "Ingrese en literal el numero de la posicion " << i << ": ";
            cin >> num[i];
        }
    else {
        cantidad = 0;
        cout << "Cantidad incorrecta!";
    }
}

void mostrar(string num[], int cantidad) {
    if (cantidad == 0)
        cout << "Primero debe cargar los datos (Opcion 1).";
    else
        for (int i = 0;i < cantidad; i++)
            cout << "num[" << i << "] = " << num[i] << endl;
}

string ejecutar(string num[], int numero) {
    for (int i = 0;i <= numero; i++)
        if (i == numero - 1)
            return num[i];
}
