// Calcular cubo, menor y signo en menu

#include <iostream>
#include "conio.h"
#include "stdlib.h"
#include "Math.h"

using namespace std;

float cubo(float n);
int CalcularMenor(int a, int b);
int signo(float a);

void main()
{
	float b, a, d, n, c;
	int opcion, menor;
	// Menu
	do {
		//Desplegar las opciones
		cout << "\t\t Menu \n";
		cout << "\t\t ==== \n";
		cout << "1. Cubo de un numero. \n";
		cout << "2. Calcular menor entre 2 numeros.\n";
		cout << "3. Determinar signo de un numero.\n";
		cout << "0. Salir\n";
		cout << "Opcion: ";
		cin >> opcion;
		// Condicional multiple
		switch (opcion)
		{
		case 1: cout << "Ingrese un numero real para elevar al cubo: ";
			cin >> n;
			c = cubo(n);
			cout << "El cubo de " << n << " es : " << c<<endl;
			break;
		case 2: cout << "Ingrese un numero: ";
			cin >> a;
			cout << "Ingrese el otro numero: ";
			cin >> b;
			menor = CalcularMenor(a, b);
			cout << "El numero menor es: " << menor<<endl;
			break;
		case 3: cout << "Ingrese el numero: ";
			cin >> d;
			c = signo(d);
			cout << "El signo del numero es: "<< c<<endl;
			break;
		case 0: cout << "Saliendo del Menu";
			break;
		default: cout << "ERROR de opcion";
			break;
		}
		system("pause");
		system("cls");
	} while (opcion != 0);

}
float cubo(float n){
	float cubo;
	return n * n * n;
}
int CalcularMenor(int a, int b){
	if (a < b)
		return a;
	else
		return b;
}
int signo(float a){
	if (a < 0)
		return -1;
	else {
		if (a > 0)
			return 1;
		else
			return 0;
	}
}

