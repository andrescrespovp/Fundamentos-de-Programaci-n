// ejemplovector.cpp : Defines the entry point for the console application.
//	

#include <iostream>
#include "conio.h"
#define MAX 100
using namespace std;

void cargar(int vec[], int n);
void mostrar(int vec[], int n);
void burbuja(int vec[], int m);

void main() {
	int tam, n, m, A[MAX], B[MAX], C[MAX], int opcion;

	do {
		//Desplegar las opciones
		cout << "\t\t Menu \n";
		cout << "\t\t ==== \n";
		cout << "1. Cargar\n";
		cout << "2. Mostrar\n";
		cout << "3. Burbuja\n";
		cout << "4. Mostrar\n";
		cout << "0. Salir\n";
		cout << "Opcion: ";
		cin >> opcion;
		// Condicional multiple
		switch (opcion)
		{
		case 1:
			do {
				cout << "Ingresar el tamaño del primer vector:";
				cin >> n;
			} while ((n <= 0) || (n > MAX));
			cargar(A, n); // Cargar el segundo vector
			break;
		case 2:
			mostrar(A, n);
			break;
		case 3:
			burbuja(C, tam); // Clasificados en orden ascendente
			break;
		case 4:
			mostrar(C, tam); // Muestro el vector C
			break;
		case 0:
			cout << "Saliendo del Menu";
			break;
		default:
			cout << "ERROR de opcion";
			break;
		}
		getch();
		system("cls");
	} while (opcion != 0);
	getch();
}
	
	

void cargar(int vec[], int n)
{
	for (int i = 0; i < n; i++)
	{
		cout << "Vector[" << i << "]= ";
		cin >> vec[i];
	}
}

void mostrar(int vec[], int n)
{
	for (int i = 0; i < n; i++)
		cout << "Vector[" << i << "]= " << vec[i] << endl;
}

void burbuja(int vec[], int m)
{
	int aux;
	for (int i = 0; i < m - 1; i++)
	{
		for (int j = i + 1; j < m; j++)
			if (vec[i] > vec[j])
			{
				aux = vec[j];
				vec[j] = vec[i];
				vec[i] = aux;
			}
	}
}

